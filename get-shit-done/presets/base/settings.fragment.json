{
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep",
      "Glob",
      "LSP",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git blame:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git show-ref:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git symbolic-ref --short HEAD)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git worktree list:*)",
      "Bash(git stash list:*)",
      "Bash(git tag --list:*)",
      "Bash(git config --get:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(date:*)",
      "Bash(seq:*)",
      "Bash(expr:*)",
      "Bash(test:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(comm:*)",
      "Bash(nl:*)",
      "Bash(column:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",
      "Bash(uname:*)",
      "Bash(shasum:*)",
      "Bash(sha256sum:*)",
      "Bash(pgrep:*)",
      "Bash(sleep:*)",
      "Bash(command -v:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(whoami)",
      "Bash(return *)",
      "Bash(exit *)",
      "Bash(break *)",
      "Bash(continue *)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf *:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker system prune:*)",
      "Bash(docker container rm:*)",
      "Bash(docker image rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(dropdb:*)",
      "Bash(> /dev/sda:*)",
      "Bash(npm install -g:*)",
      "Bash(npm uninstall -g:*)",
      "Bash(npm i -g:*)",
      "Bash(npm install --global:*)",
      "Bash(npm uninstall --global:*)",
      "Bash(sudo npm:*)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.a?s/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.npmrc)",
      "Read(**/.git-credentials)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Bash({{stack.deploy.slot_1}}:*)",
      "Bash({{stack.deploy.slot_2}}:*)",
      "Bash({{stack.deploy.slot_3}}:*)",
      "Bash({{stack.deploy.slot_4}}:*)",
      "Bash({{stack.deploy.slot_5}}:*)"
    ],
    "ask": [
      "Bash(git rebase:*)",
      "Bash(npm uninstall:*)",
      "Bash(docker stop:*)",
      "Bash(npm rm:*)",
      "Bash(npm remove:*)",
      "Bash(docker container stop:*)",
      "Bash(docker kill:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/redirect-recursive-search.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-git-merge-target.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push-without-local-tests.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-test-command.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-denied-command.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-flake-patterns.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
